<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@color/wishlist_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/wishlistItemName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/wishlist_text"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wishlistItemPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/wishlist_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/wishlistItemUrl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:lines="1"
        android:textColor="@color/wishlist_muted_text"
        android:textSize="14sp" />

</LinearLayout>
